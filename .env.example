# mytun 本地环境变量（由 scripts/load_env.sh 加载，Makefile 自动使用）
#
# 复制成 .env 后按需修改；个人差异放 .env.local（不提交，优先级更高）。
# 注意：Go 二进制本身不读这些变量，它们只影响构建/测试工具链。

# Go 模块代理。国内网络下 proxy.golang.org 常超时。
GOPROXY=https://goproxy.cn,direct

# 全局 npm 工具链（esbuild / vitest / happy-dom），项目不建 node_modules。
# 为空则 load_env.sh / Makefile 自动探测 `npm root -g`。

# Go 安装路径（非标准位置时生效，例如 ~/.local/go/bin）
# PATH 请在 shell 里自行追加，脚本不改 PATH。

# 前端打包产物输出目录（scripts/build_web.cjs 读取）
# MYTUN_WEB_DIST_OUT=build/web-dist
